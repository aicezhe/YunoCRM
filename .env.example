# Copy to .env.local and fill in. All values come from one Supabase project
# (Project Settings -> Database / API), except the two optional AI keys.

# --- Required -------------------------------------------------------------

# Postgres. Settings -> Database -> Connection string -> URI.
# Use the DIRECT connection (port 5432) for local dev and for the pipeline
# scripts. If you point this at the transaction pooler (port 6543), src/db
# already sets prepare:false, which is what that mode requires.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Supabase Auth, used only for login sessions. Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Server-only. Needed by `npm run seed-users` and by the admin "invite user"
# action to create auth accounts. Never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# --- Optional -------------------------------------------------------------

# Semantic search. Without it the search screen says so on the page and
# exact matching keeps working. https://dash.voyageai.com
VOYAGE_API_KEY=pa-...

# Tier 2 of quarantine enrichment (Claude Haiku). Without it `npm run enrich`
# still applies its pg_trgm tier and simply logs that AI is disabled.
ANTHROPIC_API_KEY=sk-ant-...
